# What compose.yaml reads. Copy to .env beside it. These are not settings of
# the server: the API key, the bearer token and the tools live in the config
# volume, and the configuration interface writes them.

# The image: an exact release, or the minor line `0.5`, which follows its
# patch releases. To update, change it, then:
#   docker compose pull && docker compose up -d
LXO_VERSION=0.5.1

# The ports on the host, on 127.0.0.1 only: the server, and the
# configuration interface of the profile setup.
LXO_PORT=8770
LXO_SETUP_PORT=8771

# HTTPS for clients on the local network: set `https` here and Caddy starts
# in front of the server with a plain `up`, on port 443 of every address of
# this host. Empty, only the server runs, on the loopback.
COMPOSE_PROFILES=

# The name clients use, e.g. lexware.lan. Required with `https`. It has to
# resolve to this host on the clients, through the local DNS or a hosts file.
LXO_DOMAIN=

# Where its certificate comes from:
#   internal  Caddy's own CA. Every client trusts its root once, see
#             README.md. For the local network, and the default.
#   files     your own, as secrets/tls/cert.pem and secrets/tls/key.pem in
#             this folder, a company CA's for instance.
#   acme      a public CA. Needs this host reachable from the internet on
#             port 443, which this server is not built for.
LXO_TLS=internal

# The port on the host, if 443 is taken.
LXO_HTTPS_PORT=443
