# Sample configuration for the unofficial Lexware Office MCP server.
#
# It ships with the package, so this text is the same whether you cloned the
# repository or installed the wheel. To start a settings file from it:
#
#     benethos-lexware-office-mcp --settings-sample > config/.env
#
# Then fill in your API key. `setup` writes the same file through a browser
# and is the easier route. Nothing here is read at runtime: this is the
# documentation of every setting, and it must never contain a real key.
#
# The file holds a credential for a live accounting system. Keep it out of
# version control, out of shared folders, and out of backups others can read.
# When you stop using the server, delete it and revoke the key in Lexware
# Office as well.
#
# Where settings are read from, highest precedence first:
#   1. a real environment variable
#   2. `.env` in the working directory
#   3. `config/.env` in the working directory
#   4. `config/.env` of the clone this server runs from
#   5. `.env` in the per-user config directory
#
# Rule 4 is why this file works even when a client such as Claude Desktop
# starts the server with a working directory of its own. It applies to a
# source checkout only, never to an installed package.
#
# Every line below is commented out except the API key, so a copy of this file
# with only the key filled in leaves the server at its safe defaults.

# --- Required ---------------------------------------------------------------
# Your API key, created in Lexware Office under Extensions, Public API:
# https://app.lexware.de/addons/public-api
# The key is shown once. It can be revoked on the same page at any time.
LXO_MCP_API_KEY=

# --- Permissions ------------------------------------------------------------
# Not set here. Which tools this server offers is one flag per tool in
# tools.json, written with `benethos-lexware-office-mcp --tools read-only` and
# edited by hand. Without that file the server offers nothing at all, which is
# the right state until somebody has decided what this account may be used
# for. See LXO_MCP_TOOL_POLICY below.

# --- Endpoints --------------------------------------------------------------
# LXO_MCP_BASE_URL=https://api.lexware.io
# Used to build permalinks into the web app, see get_deeplink.
# LXO_MCP_APP_BASE_URL=https://app.lexware.de

# --- Rate limiting ----------------------------------------------------------
# The Lexware API allows 2 requests per second, counted across all endpoints at
# once rather than per endpoint. The default below stays under that on purpose:
# the API documentation warns that aiming exactly at the limit still produces
# 429 responses once network jitter shifts the arrival times.
#
# The budget belongs to your account, not to this process. A second server
# instance, another integration, or a script you run yourself all spend from
# the same two per second.
# LXO_MCP_RATE=1.5
# The account's own bucket holds 4, measured. The default leaves half of
# that for anything else using the same account.
# LXO_MCP_BURST=2

# --- Behaviour --------------------------------------------------------------
# Rows per page a search requests and returns. The API caps this at 250.
# LXO_MCP_PAGE_SIZE=25

# How many pages of a PDF read_download renders when the call does not say.
# Not the same thing as the page size above: that one counts rows of a search
# result, this one counts sheets of a document. A rendered page costs roughly
# two thousand tokens whatever it weighs in bytes, so lower this on a tight
# context budget. A caller can always override it per call.
# LXO_MCP_PDF_PAGES=10

# Where the per-tool policy lives: one on/off flag per tool, in JSON.
# Searched exactly like this file: the per-user config directory first, then
# config/ of a checkout, then the working directory - last one found wins. So
# a tools.json beside this sample overrides an installed one. A tool the file
# does not mention is off, and without the file no tool is offered at all -
# see the Permissions block above. Write a starting point in the browser with
# `benethos-lexware-office-mcp setup`, or on the command line with
# `--tools read-only`, then edit by hand. Set this only to put the file
# somewhere else entirely.
# LXO_MCP_TOOL_POLICY=

# Seconds before an HTTP request is given up on.
# LXO_MCP_TIMEOUT=30

# Where downloaded documents are written. Defaults to the per-user cache
# directory. Downloaded documents are real business records, and a file that
# is already there is never overwritten.
# LXO_MCP_DOWNLOAD_DIR=

# LXO_MCP_LOG_LEVEL=INFO
